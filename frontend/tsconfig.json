{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "jsx": "react",
    "strict": false,
    "allowJs": false,
    "skipLibCheck": true,
    "outDir": "public",
    "lib": ["ES2020", "DOM"],
    "moduleResolution": "node",
    "noEmitOnError": true
  },
  "include": ["src/app.tsx", "src/react-types.d.ts"],
  "exclude": ["src/modern-entry.ts"]
}
