# Copy this file to .env. Never commit .env, secrets, OAuth tokens or customer data.
APP_ENV=development
DATABASE_URL=sqlite:///./omnichat.db
# If using Docker Compose, its web container overrides DATABASE_URL to PostgreSQL.
POSTGRES_DB=omnichat
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Set ONLY to the CIDR of your actual trusted reverse proxy; leave empty locally.
TRUSTED_PROXY_CIDRS=
# Optional independent secret for pseudonymized public rate-limiter keys.
PUBLIC_RATE_LIMIT_SECRET=
ENABLE_API_DOCS=true
ENABLE_OUTBOX_WORKER=true
# R32: max encrypted inbound jobs with pending payload per live channel;
# when full, authenticated provider webhooks receive HTTP 503 + Retry-After.
INBOUND_MAX_PENDING_PER_CHANNEL=5000
ENABLE_AVITO_POLLING=true
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
INTEGRATION_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_PREVIOUS_KEYS=
# Avito: apply for official Business Messenger API access.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Instagram Login: register a Meta App, approve the required permissions.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta WhatsApp webhook validation (create a random user-chosen token).
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_APP_SECRET=
INSTAGRAM_APP_SECRET_WEBHOOK=
# For Caddy HTTPS reverse proxy, e.g. chat.example.com
PUBLIC_HOST=localhost

# OSMANX v0.6: ONE platform Meta app, many independent customer businesses.
# These are PLATFORM-OWNER app settings; never ask customers to expose an App Secret.
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# App-level Facebook Page / Instagram and WABA webhook verification uses this token.
# Only the platform admin configures it inside Meta App Dashboard.
# Existing META_WEBHOOK_VERIFY_TOKEN above must be strong and random.
# FACEBOOK_APP_SECRET can fallback to META_APP_SECRET for a shared app; prefer explicit.
# Separate Instagram / WhatsApp apps may use the optional secrets below.
AVITO_OAUTH_SCOPES=messenger:read,messenger:write

# v1.4: legacy React 16 build remains the tested default.
# Set to modern only after npm install/build:modern and browser smoke tests.
FRONTEND_MODE=legacy
